# AIview Environment Variables
# Copy this file to .env.local and fill in your keys

# ── AI APIs ──────────────────────────────────────────────────────────
# Get your Groq API key (free) from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Auth ──────────────────────────────────────────────────────────────
# Change this to a long random string in production
JWT_SECRET=aiview-change-this-secret-in-production

# ── Database (optional, for production) ──────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/aiview

# ── Payments (optional) ──────────────────────────────────────────────
# RAZORPAY_KEY_ID=your_razorpay_key
# RAZORPAY_KEY_SECRET=your_razorpay_secret
